{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "lib": ["ES2020"],
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "moduleResolution": "node",
        "paths": {
            "@tauri-apps/api/core": ["./src/webview-ui/mocks/tauri-apps-api-core.ts"],
            "@tauri-apps/plugin-dialog": ["./src/webview-ui/mocks/tauri-apps-plugin-dialog.ts"],
            "@tauri-apps/plugin-fs": ["./src/webview-ui/mocks/tauri-apps-plugin-fs.ts"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "**/*.spec.ts", "src/webview-ui/**/*"]
}
