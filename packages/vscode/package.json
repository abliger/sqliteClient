{
    "name": "sqlite-client",
    "displayName": "SQLite Client",
    "description": "A powerful SQLite client for VSCode",
    "version": "0.1.0",
    "publisher": "sqlite-client",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Database",
        "Visualization"
    ],
    "keywords": [
        "sqlite",
        "database",
        "sql",
        "client"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onCommand:sqliteClient.open",
        "onCommand:sqliteClient.openDatabase",
        "onCustomEditor:sqliteClient.editor"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "sqliteClient.open",
                "title": "Open SQLite Client",
                "category": "SQLite Client"
            },
            {
                "command": "sqliteClient.openDatabase",
                "title": "Open SQLite Database",
                "category": "SQLite Client",
                "icon": "$(database)"
            },
            {
                "command": "sqliteClient.closeConnection",
                "title": "Close Connection",
                "category": "SQLite Client",
                "icon": "$(close)"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "sqliteClient.open"
                },
                {
                    "command": "sqliteClient.openDatabase"
                }
            ],
            "editor/title": [
                {
                    "command": "sqliteClient.openDatabase",
                    "group": "navigation",
                    "when": "resourceExtname == .db || resourceExtname == .sqlite || resourceExtname == .sqlite3"
                }
            ],
            "explorer/context": [
                {
                    "command": "sqliteClient.openDatabase",
                    "group": "2_open@10",
                    "when": "resourceExtname == .db || resourceExtname == .sqlite || resourceExtname == .sqlite3"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "sqliteClient.editor",
                "displayName": "SQLite Client",
                "selector": [
                    {
                        "filenamePattern": "*.{db,sqlite,sqlite3,db3}"
                    }
                ],
                "priority": "default"
            }
        ]
    },
    "scripts": {
        "build": "pnpm rebuild:native && pnpm build:extension && pnpm build:webview && pnpm copy:native",
        "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:better-sqlite3 --format=cjs --platform=node",
        "build:webview": "vite build",
        "rebuild:native": "electron-rebuild -f -w better-sqlite3",
        "copy:native": "node scripts/copy-native.js",
        "dev": "vite build --watch",
        "package": "pnpm build && npx vsce package --no-dependencies",
        "lint": "eslint src --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.16",
        "@heroicons/vue": "^2.1.1",
        "@monaco-editor/loader": "^1.4.0",
        "@vueuse/core": "^14.2.1",
        "better-sqlite3": "^9.4.0",
        "bindings": "^1.5.0",
        "echarts": "^5.4.3",
        "file-uri-to-path": "^1.0.0",
        "monaco-editor": "^0.45.0",
        "pinia": "^2.1.7",
        "sql-formatter": "^15.7.2",
        "uuid": "^9.0.1",
        "vue": "^3.4.0",
        "vue-i18n": "9"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.8",
        "@types/node": "^20.10.0",
        "@types/vscode": "^1.85.0",
        "@vitejs/plugin-vue": "^4.5.0",
        "@vitejs/plugin-vue-jsx": "^3.1.0",
        "@vitest/coverage-v8": "^1.0.0",
        "electron": "^30.5.1",
        "electron-rebuild": "^3.2.9",
        "esbuild": "^0.19.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vitest": "^1.0.0"
    }
}
