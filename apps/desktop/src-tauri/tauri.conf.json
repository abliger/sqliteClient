{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "SQLite Client",
    "version": "0.1.0",
    "identifier": "com.sqliteclient.app",
    "build": {
        "beforeDevCommand": "cd ../../packages/ui && pnpm dev",
        "beforeBuildCommand": "cd ../../packages/ui && pnpm build",
        "frontendDist": "../../../packages/ui/dist",
        "devUrl": "http://localhost:5173"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "SQLite Client",
                "width": 1400,
                "height": 900,
                "minWidth": 1000,
                "minHeight": 700,
                "center": true,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "visible": true,
                "focus": true
            }
        ],
        "security": {
            "csp": null,
            "capabilities": ["default"]
        }
    },
    "bundle": {
        "active": true,
        "targets": ["dmg", "app", "msi", "nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/256x256.png",
            "icons/512x512.png",
            "icons/icon.ico",
            "icons/icon.png"
        ],
        "macOS": {
            "frameworks": [],
            "minimumSystemVersion": "10.13",
            "signingIdentity": null,
            "entitlements": null
        },
        "windows": {
            "wix": {
                "language": ["zh-CN", "en-US"]
            },
            "nsis": {
                "languages": ["SimpChinese", "English"]
            }
        },
        "fileAssociations": [
            {
                "ext": ["db"],
                "name": "SQLite Database",
                "description": "SQLite database file",
                "role": "Editor"
            },
            {
                "ext": ["sqlite"],
                "name": "SQLite Database",
                "description": "SQLite database file",
                "role": "Editor"
            },
            {
                "ext": ["sqlite3"],
                "name": "SQLite3 Database",
                "description": "SQLite3 database file",
                "role": "Editor"
            },
            {
                "ext": ["db3"],
                "name": "SQLite3 Database",
                "description": "SQLite3 database file",
                "role": "Editor"
            }
        ]
    }
}
